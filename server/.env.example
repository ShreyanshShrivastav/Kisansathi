# ──────────────────────────────────────────────────────────────────────
# KisanSathi — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────

# ─── Node ─────────────────────────────────────────────────────────────
NODE_ENV=development         # Set to 'production' in prod (enables secure cookies)
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/kisansathi

# ─── JWT ──────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.:
#   node -e "const c=require('crypto'); console.log(c.randomBytes(64).toString('hex'));"
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET

# Optional — defaults applied in authController.js if omitted
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
